flowchart TB
    subgraph ontology["Ontology 语义与治理"]
        TYPE["Object Type：身份、属性、链接"]
        SECURITY["对象数据与 Action 授权"]
    end
    TYPE --> STANDARD["Standard View：元数据自动展示"]
    TYPE --> OV["Configured View：类型级配置与版本"]
